# SQLite works out of the box for local dev; docker-compose sets a PostgreSQL URL.
DATABASE_URL=sqlite:///./hiretrack.db
# DATABASE_URL=postgresql+psycopg://hiretrack:hiretrack@localhost:5432/hiretrack
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=false
AUTO_REFRESH_HOURS=12
# Free key from https://developer.adzuna.com (enables the Adzuna India source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
